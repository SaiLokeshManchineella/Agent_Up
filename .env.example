# Required — OpenAI for chat simulation, scoring, and fallback TTS
OPENAI_API_KEY=sk-...

# Required — Deepgram Nova-2 for streaming speech-to-text
DEEPGRAM_API_KEY=

# Optional — Cartesia Sonic for low-latency TTS (~130ms). Falls back to OpenAI TTS → browser speechSynthesis
CARTESIA_API_KEY=

# Optional — Override default model (gpt-4o-mini). Set to gpt-4o for higher quality.
OPENAI_MODEL=gpt-4o-mini
